# KhidmatConnect AI — Environment Configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to version control.

# PostgreSQL database connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/khidmatconnect"

# Alibaba Cloud Model Studio (Qwen AI) — Singapore region
# Get API key: https://www.alibabacloud.com/help/en/model-studio/get-api-key
#
# BASE_URL: Use your workspace-specific endpoint (preferred):
#   https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Or the legacy international endpoint:
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Both API_KEY and BASE_URL are required for AI enrichment to activate.
ALIBABA_MODEL_STUDIO_API_KEY=
ALIBABA_MODEL_STUDIO_BASE_URL=
ALIBABA_MODEL_NAME=qwen3.7-plus

# Google Maps Platform
# Browser key: for Maps JavaScript API (client-side only)
#   Restrict to: HTTP referrers + Maps JavaScript API
# Server key: for Geocoding API, Routes API (server-side only)
#   Restrict to: IP addresses + Geocoding API, Routes API
# Do NOT use NEXT_PUBLIC_ for the server key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
