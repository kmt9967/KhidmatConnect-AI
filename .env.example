# KhidmatConnect AI — Environment Variables
# Copy this file to .env.local and fill in the values.

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/khidmatconnect?schema=public"

# Alibaba Cloud Model Studio / Qwen AI ────────────────────
# BASE_URL format: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Singapore workspace example: https://dashscope-intl.aliyuncs.com/api/v1/workspaces/{WorkspaceId}/compatible-mode/v1
ALIBABA_MODEL_STUDIO_API_KEY=
ALIBABA_MODEL_STUDIO_BASE_URL=
ALIBABA_MODEL_NAME=qwen3.7-plus

# Alibaba Voice Models (verify availability in Model Studio)
ALIBABA_ASR_MODEL=qwen3-asr-flash
ALIBABA_TTS_MODEL=qwen3-tts-flash
ALIBABA_FAST_MODEL_NAME=qwen-turbo

# ─── Google Maps Platform ────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# ─── Google Cloud Speech-to-Text V2 (Primary ASR) ───────────
# Setup: 1) Enable Speech-to-Text API in GCP Console
#        2) gcloud auth application-default login
#        3) Set project ID below
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SPEECH_LOCATION=asia-southeast1
GOOGLE_SPEECH_MODEL=chirp_2
# Optional: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Twilio (Phone Emergency Intake) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=

# ─── NextAuth / Authentication — Not yet configured ──────────
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
