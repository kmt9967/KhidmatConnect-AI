# KhidmatConnect AI — Environment Variables
# Copy this file to .env.local (development) or .env.production (server)
# and fill in the values. NEVER commit real secrets.

# ─── Application ────────────────────────────────────────
# Canonical public base URL of this deployment (used for redirects and any
# generated public links). In production set to your HTTPS origin, e.g.
# APP_BASE_URL=https://demo.example.org
APP_BASE_URL=

# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/khidmatconnect?schema=public"

# Alibaba Cloud Model Studio / Qwen AI ────────────────────
# BASE_URL format: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Singapore workspace example: https://dashscope-intl.aliyuncs.com/api/v1/workspaces/{WorkspaceId}/compatible-mode/v1
ALIBABA_MODEL_STUDIO_API_KEY=
ALIBABA_MODEL_STUDIO_BASE_URL=
ALIBABA_MODEL_NAME=qwen3.7-plus

# Alibaba Voice Models (verify availability in Model Studio)
ALIBABA_ASR_MODEL=qwen3-asr-flash
ALIBABA_TTS_MODEL=qwen3-tts-flash
ALIBABA_FAST_MODEL_NAME=qwen-turbo

# ─── Google Maps Platform ────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# ─── Google Cloud Speech-to-Text V2 (Primary ASR) ───────────
# Setup: 1) Enable Speech-to-Text API in GCP Console
#        2) gcloud auth application-default login
#        3) Set project ID below
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SPEECH_LOCATION=asia-southeast1
GOOGLE_SPEECH_MODEL=chirp_2
# Server deployments: prefer a service-account key file via ADC:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/khidmatconnect/gcp-service-account.json
# (If unset, the gcloud well-known path is used: %APPDATA%/gcloud on Windows,
#  ~/.config/gcloud on Linux/macOS.)

# ─── Twilio (LEGACY prototype voice intake — superseded by Retell, kept working) ─
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public origin Twilio must call back to (set to APP_BASE_URL value in prod).
# Falls back to the live request origin behind nginx if empty.
TWILIO_WEBHOOK_BASE_URL=

# ─── Retell AI (M9 FINAL VOICE — realtime conversational intake) ────
# Retell owns the realtime phone conversation (ASR/turn-taking/TTS/LLM).
# KhidmatConnect stays authoritative: webhooks + the update_case custom
# function create/complete real EmergencyCases, and Alibaba Qwen (above)
# remains the ONLY emergency decision-support analyzer.
#
# RETELL_API_KEY is used BOTH as the REST Bearer key AND as the HMAC secret
# that verifies X-Retell-Signature on /api/voice/retell/webhook and
# /api/voice/retell/update-case (use the key with the webhook badge in the
# Retell dashboard — Retell has no separate webhook secret).
RETELL_API_KEY=
# Optional — only needed for server-side outbound/test calls later:
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# ─── Voice Audio Storage ──────────────────────────────
# Persistent directory for generated/stored call audio. Production should
# point OUTSIDE the app/build directory, e.g.:
# VOICE_AUDIO_DIR=/var/lib/khidmatconnect/audio
# Defaults to ./.audio-cache (development).
VOICE_AUDIO_DIR=

# ─── Session Signing (REQUIRED in production) ────────────────
# Used to sign the kc_session auth cookie. Generate with:
#   openssl rand -base64 48
# The app refuses to create sessions in production without this.
SESSION_SECRET=

# ─── Demo scripts (optional) ──────────────────────────────
# Explicit env file for npm run demo:seed / demo:reset on a server
# (otherwise .env.local, then .env.production are tried in order).
# KC_ENV_FILE=/var/www/KhidmatConnect-AI/.env.production
